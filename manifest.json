{
  "schemaVersion": 1,
  "id": "rohirik.plugin-lab",
  "name": "Plugin Lab",
  "version": "0.1.0",
  "author": "RohiRIK",
  "license": "MIT",
  "description": "Lifecycle, health and GitHub feedback for the Omarchy shell plugins you build, with one-click fixes by your default agent.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Plugin Lab",
    "description": "Lifecycle, health and GitHub feedback for the Omarchy shell plugins you build.",
    "category": "System",
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 300
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh every (seconds)",
        "min": 60,
        "max": 3600,
        "step": 60,
        "defaultValue": 300
      }
    ]
  }
}
